{
  "name": "compare-commits-action",
  "version": "6.0.2",
  "private": true,
  "description": "Compare the differences between two commits",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint .",
    "package": "ncc build --no-source-map-register --license licenses.txt --target es2019",
    "all": "npm run build && npm run format-check && npm run lint && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpcloud/compare-commits-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup",
    "git",
    "github",
    "commits",
    "octokit"
  ],
  "author": "Phillip Cloud <417981+cpcloud@users.noreply.github.com>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@octokit/rest": "22.0.1",
    "markdown-table": "3.0.4",
    "tunnel": "0.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/eslint": "9.6.1",
    "@types/node": "25.9.5",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vercel/ncc": "0.44.1",
    "eslint": "^10.8.0",
    "eslint-plugin-github": "6.1.2",
    "js-yaml": "5.2.2",
    "prettier": "3.9.6",
    "semantic-release": "25.0.8",
    "typescript": "6.0.3"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/github",
        {
          "successComment": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "dist/*",
            "package.json",
            "package-lock.json",
            "CHANGELOG.md"
          ]
        }
      ]
    ]
  }
}
